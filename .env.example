# Copy to .env and fill in. The .env file is ignored by git.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=

# JWT signing key: at least 32 characters.
JWT_SIGNING_KEY=

# LLM provider (OpenAI-compatible API). LLM_BASE_URL is optional.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Frontend origin allowed by CORS (no trailing slash).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# true enables the demo dialogue generator (POST /api/demo/dialogue).
FEATURES_ALLOW_DIALOGUE=false
